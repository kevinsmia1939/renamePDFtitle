[Desktop Entry]
Type=Service
ServiceTypes=KonqPopupMenu/Plugin
MimeType=application/pdf;
Actions=renamePDFtotitle;
X-KDE-Priority=TopLevel
X-KDE-StartupNotify=false

[Desktop Action renamePDFtotitle]
Icon=edit-rename
Name=Rename PDF file to its title
Name[nl]=Bestandsnaam wijzigen naar titel
Name[bg]=Преименуване на PDF файла според заглавието му
Name[cs]=Přejmenovat soubor PDF podle jeho názvu
Name[da]=Omdøb PDF-fil til dens titel
Name[de]=PDF-Datei nach ihrem Titel umbenennen
Name[el]=Μετονομασία αρχείου PDF σύμφωνα με τον τίτλο του
Name[es]=Renombrar archivo PDF según su título
Name[et]=Nimeta PDF-fail ümber pealkirja järgi
Name[fi]=Nimeä PDF-tiedosto uudelleen sen otsikon mukaan
Name[fr]=Renommer le fichier PDF d’après son titre
Name[he]=שינוי שם קובץ PDF לכותרת שלו
Name[hr]=Preimenuj PDF datoteku prema njenom naslovu
Name[hu]=PDF-fájl átnevezése a címére
Name[is]=Endurnefna PDF-skrá eftir titli hennar
Name[it]=Rinomina il file PDF in base al suo titolo
Name[ja]=PDFファイル名をタイトルに変更
Name[ko]=PDF 파일 이름을 제목으로 변경
Name[no]=Endre navn på PDF-filen til tittelen
Name[pl]=Zmień nazwę pliku PDF na jego tytuł
Name[pt]=Renomear ficheiro PDF para o seu título
Name[pt_BR]=Renomear arquivo PDF para o seu título
Name[ro]=Redenumește fișierul PDF după titlul său
Name[ru]=Переименовать PDF-файл по его заголовку
Name[sk]=Premenovať súbor PDF podľa jeho názvu
Name[sv]=Byt namn på PDF-filen till dess titel
Name[tr]=PDF dosyasını başlığına göre yeniden adlandır
Name[uk]=Перейменувати PDF-файл за його назвою
Name[zh]=将 PDF 文件重命名为其标题
Exec=bash -c 'FILE="%f"; TITLE=$(pdfinfo "$FILE" | grep "Title:" | sed "s/Title:\\s*//"); if [ -n "$TITLE" ]; then DIR=$(dirname "$FILE"); NEW_NAME="$DIR/$TITLE.pdf"; mv "$FILE" "$NEW_NAME"; else kdialog --error "No title found in PDF metadata"; fi'
